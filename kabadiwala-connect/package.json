{
  "name": "kabadiwala-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-environment.mjs",
    "test": "npm run test:unit && npm run test:api",
    "dev:web": "next dev apps/web --hostname 0.0.0.0",
    "build:web": "next build apps/web",
    "start:web": "next start apps/web --hostname 0.0.0.0",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test:web:smoke": "node --test test/web-smoke.mjs",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "start:api": "node apps/api/dist/server.js",
    "test:api": "npm run build:api && node --test test/api/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs test/web/*.test.mjs",
    "test:connection": "node --test test/integration/connection.test.mjs",
    "migrate:auth": "npm run build:api && node apps/api/dist/migrate-auth.js",
    "migrate:authorization": "npm run build:api && node apps/api/dist/migrate-account-store.js",
    "migrate:customer-details": "npm run build:api && node apps/api/dist/migrate-customer-details.js",
    "migrate:pickups": "npm run build:api && node apps/api/dist/migrate-pickups.js",
    "migrate:catalog": "npm run build:api && node apps/api/dist/migrate-catalog.js"
  },
  "dependencies": {
    "better-auth": "1.7.24",
    "express": "5.3.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2"
  }
}
