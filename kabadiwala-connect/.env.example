# Copy to .env (ignored), fill in locally. Never commit secrets or post them in chat.
# Google authentication is deliberately disabled by default and in production.
AUTH_ENABLED=false
# Use the exact public web origin and match it in both API and web environments.
AUTH_PUBLIC_ORIGIN=http://localhost:3000
# Set to a disposable development PostgreSQL database URL, NOT production data.
DATABASE_URL=
# Generate at least 32 cryptographically random characters for local development.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side web-to-API address, never exposed as a browser-facing URL.
API_INTERNAL_ORIGIN=http://127.0.0.1:4000

# Payouts: no payment provider exists yet. Recording a payout is a manual ledger
# entry and never transfers money. These are intentional blanks, not secrets to
# fill in -- leave them empty until the payment mechanism is decided.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=

# Notifications: in-app only, and in-app needs no configuration -- there is no
# transport, queue or provider behind it. The blanks below are for a future
# external channel: no email, SMS or WhatsApp message is sent, and the UI says so.
NOTIFICATION_CHANNEL=in-app
NOTIFICATION_SMTP_URL=
NOTIFICATION_SMS_KEY=

# Retention: no configuration is needed to run a dry run. The apply flag is a
# command-line environment variable, not a .env setting, so it cannot be left on
# by accident: RETENTION_APPLY_CONFIRM=yes plus --apply. Nothing sweeps on a
# timer, and no schedule belongs in this file.
