# ============================================================================
# Kabadiwala Connect — Environment Template
#
# Copy to .env, then generate real secrets:
#     cp .env.example .env
#     npm run env:generate
#
# The API REFUSES TO BOOT if any required secret is missing or shorter than
# the minimum length. There are no fallback "dev" secrets in the source code.
# ============================================================================

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Publicly reachable base URL — used to print your gateway webhook URL.
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL connection string (works with external PostgreSQL 16 OR embedded PGlite)
USE_EXTERNAL_POSTGRES=false
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/kabadiwala?sslmode=disable"

# Optional Redis 7 URL for distributed rate limiting (falls back to in-memory store when omitted)
# REDIS_URL="redis://127.0.0.1:6379"

# ----------------------------------------------------------------------------
# PAYMENTS
# ----------------------------------------------------------------------------
# "mock"     → local simulator, real state machine + real HMAC verification,
#              but no rupee ever moves. Blocked when NODE_ENV=production.
# "razorpay" → live UPI / cards / netbanking via api.razorpay.com.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

# REQUIRED (>=32 chars). Server-side HMAC secret for simulated payout callbacks.
# Generate with: npm run env:generate
PAYMENT_WEBHOOK_SECRET=

# Only needed when PAYMENT_PROVIDER=razorpay.
# Dashboard → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → add endpoint → Secret
# Endpoint URL: https://<your-public-host>/api/v1/webhooks/payments/razorpay
# Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Enables POST /api/v1/payments/intents/:id/simulate.
# Ignored (forced off) when NODE_ENV=production.
ALLOW_PAYMENT_SIMULATION=true

# "simulated" → payouts recorded but not sent.
# "razorpayx" → real UPI payouts (requires RazorpayX + current account + KYC).
PAYOUT_PROVIDER=simulated
# RAZORPAYX_ACCOUNT_NUMBER=

# ----------------------------------------------------------------------------
# OTP / SMS
# ----------------------------------------------------------------------------
# Pluggable SMS / WhatsApp OTP Gateway ("sandbox" | "msg91" | "twilio")
SMS_PROVIDER="sandbox"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15005550006"

# ----------------------------------------------------------------------------
# SECRETS — all REQUIRED, generate with `npm run env:generate`
# ----------------------------------------------------------------------------
# Private KYC Vault Storage Backend ("local-fs" | "s3-compatible")
VAULT_STORAGE_DRIVER="local-fs"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SIGNED_URL_SECRET=

JWT_ISSUER="kabadiwala-connect-api"
JWT_AUDIENCE="kabadiwala-connect-clients"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Internal backend URL used by Next.js server proxy
INTERNAL_API_URL="http://127.0.0.1:4000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
