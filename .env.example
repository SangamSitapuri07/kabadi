# Kabadiwala Connect — Environment Template (Copy to .env for local development)

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# PostgreSQL connection string (works with external PostgreSQL 16 OR embedded PGlite)
USE_EXTERNAL_POSTGRES=false
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/kabadiwala?sslmode=disable"

# Optional Redis 7 URL for distributed rate limiting (falls back to in-memory store when omitted)
# REDIS_URL="redis://127.0.0.1:6379"

# Pluggable SMS / WhatsApp OTP Gateway ("sandbox" | "msg91" | "twilio")
SMS_PROVIDER="sandbox"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15005550006"

# Signed Payment / UPI Payout Webhook Secret (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET="dev-only-replace-me-webhook-hmac-secret-min-32-chars"

# Private KYC Vault Storage Backend ("local-fs" | "s3-compatible")
VAULT_STORAGE_DRIVER="local-fs"

# Cryptographic keys — replace with strong 256-bit random values in staging/production
JWT_ACCESS_SECRET="dev-only-replace-me-access-secret-min-32-chars-8f4b2c1a9e7d6f3b"
JWT_REFRESH_SECRET="dev-only-replace-me-refresh-secret-min-32-chars-3a9c7e5b1d8f4a2c"
SIGNED_URL_SECRET="dev-only-replace-me-signed-url-secret-min-32-chars-6d2e9a4c8b1f7e3a"

JWT_ISSUER="kabadiwala-connect-api"
JWT_AUDIENCE="kabadiwala-connect-clients"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Internal backend URL used by Next.js server proxy
INTERNAL_API_URL="http://127.0.0.1:4000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
